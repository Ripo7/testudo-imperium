  "private": true,
  "description": "Real-time strategy on a procedural continent: Rome, Carthage, the Gauls and Egypt fight, trade and make peace.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
